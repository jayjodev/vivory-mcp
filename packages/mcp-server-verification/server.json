{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jayjodev/vivory-mcp-verification",
  "title": "Vivory Verification Gateway",
  "description": "101 MCP tools for verifiable AI: citations, law, KYB, peer review, forecast, reconcile, provenance.",
  "websiteUrl": "https://api.vivory.app",
  "repository": {
    "url": "https://github.com/jayjodev/vivory-mcp",
    "source": "github",
    "subfolder": "packages/mcp-server-verification"
  },
  "version": "0.11.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "vivory-mcp-verification",
      "version": "0.11.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VIVORY_API_KEY",
          "description": "Optional Vivory Pro API key for higher daily limits (10,000/day Pro vs 100/day anonymous). Get one at api.vivory.app/dashboard.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "VIVORY_API_BASE",
          "description": "Override the upstream gateway URL (default: https://api.vivory.app/api). Useful for self-hosted Vivory backends.",
          "isRequired": false,
          "isSecret": false,
          "default": "https://api.vivory.app/api"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tool": "vivory-mcp-publisher",
      "categories": ["research", "verification", "provenance", "supply-chain", "policy", "law", "sanctions", "recall", "forecast", "citations"],
      "regions": ["global"],
      "license": "MIT",
      "tool_count": 101,
      "category_count": 37,
      "pricing": {
        "anonymous": "100/day per IP, no signup",
        "tools_pro_bridge": "$4.99/mo, 1,000 calls/month (Tools Pro key)",
        "pro": "$29/mo USDC, 10,000/day, no auto-renew, no custody",
        "unified_key_unlocks": ["vivory-mcp-korea", "vivory-mcp-verification"],
        "checkout": "https://api.vivory.app/dashboard/public-api"
      },
      "sibling_packages": ["vivory-mcp-korea"]
    }
  }
}
